datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id             String         @id @default(cuid())
  email          String         @unique
  name           String?
  hashedPassword String?
  emailVerified  DateTime?
  image          String?
  role           String         @default("USER") // USER, ADMIN
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  accounts       Account[]
  sessions       Session[]
  subscription   Subscription?
  resumes        Resume[]
  coverLetters   CoverLetter[]
  usageLogs      UsageLog[]
  jobTailorings  JobTailoring[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Subscription {
  id                   String    @id @default(cuid())
  userId               String    @unique
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique
  stripePriceId        String?
  plan                 String    @default("FREE") // FREE, PRO_MONTHLY, PRO_ANNUAL
  status               String    @default("ACTIVE") // ACTIVE, CANCELED, PAST_DUE
  currentPeriodStart   DateTime  @default(now())
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean   @default(false)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@map("subscriptions")
}

model Resume {
  id             String          @id @default(cuid())
  userId         String
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  title          String          @default("Untitled Resume")
  slug           String          @unique @default(cuid())
  templateId     String          @default("modern-minimal")
  language       String          @default("en")
  isRtl          Boolean         @default(false)
  
  // Stored as JSON conforming strictly to ResumeDataSchema
  content        String          @default("{}")
  
  // Design & layout overrides (font, colors, spacing, margins)
  design         String          @default("{}")

  // Publication & Sharing
  isPublished    Boolean         @default(false)
  shareSlug      String?         @unique
  hasWatermark   Boolean         @default(true)
  
  // ATS & Analytics
  atsScore       Int?
  lastExportedAt DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  versions       ResumeVersion[]
  jobTailorings  JobTailoring[]

  @@map("resumes")
}

model ResumeVersion {
  id            String   @id @default(cuid())
  resumeId      String
  resume        Resume   @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  versionNumber Int
  title         String?
  content       String   @default("{}")
  design        String   @default("{}")
  createdAt     DateTime @default(now())

  @@unique([resumeId, versionNumber])
  @@map("resume_versions")
}

model CoverLetter {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  resumeId   String?
  title      String   @default("Untitled Cover Letter")
  recipient  String?
  content    String   @default("")
  templateId String   @default("cover-standard")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("cover_letters")
}

model UsageLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String
  tokens    Int      @default(0)
  metadata  String?
  createdAt DateTime @default(now())

  @@map("usage_logs")
}

model JobTailoring {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  resumeId        String
  resume          Resume   @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  jobTitle        String
  companyName     String?
  jobDescription  String
  matchScore      Int?
  missingKeywords String?
  tailoredDiff    String?
  createdAt       DateTime @default(now())

  @@map("job_tailorings")
}

