# ==============================================================================
# ResumeForge — Production & Local Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Connection
# ------------------------------------------------------------------------------
# Local zero-setup SQLite:
DATABASE_URL="file:./dev.db"

# Production PostgreSQL:
# DATABASE_URL="postgresql://resumeforge:secure_password@localhost:5432/resumeforge?schema=public"

# ------------------------------------------------------------------------------
# 2. Authentication (NextAuth.js)
# ------------------------------------------------------------------------------
NEXTAUTH_URL="http://localhost:3000"
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="resumeforge_jwt_secret_key_minimum_32_characters_long_for_security"

# Optional OAuth Providers:
# GOOGLE_CLIENT_ID="your-google-oauth-client-id"
# GOOGLE_CLIENT_SECRET="your-google-oauth-client-secret"

# ------------------------------------------------------------------------------
# 3. AI Services (Anthropic Claude 3.5 Sonnet)
# ------------------------------------------------------------------------------
# If omitted, ResumeForge seamlessly uses the built-in deterministic heuristic AI engine.
ANTHROPIC_API_KEY="sk-ant-api03-your-anthropic-claude-api-key"

# ------------------------------------------------------------------------------
# 4. Payments & Subscriptions (Stripe)
# ------------------------------------------------------------------------------
STRIPE_SECRET_KEY="sk_test_51..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_51..."

# Stripe Pricing IDs for Pro Plans (Monthly & Annual):
STRIPE_PRO_MONTHLY_PRICE_ID="price_pro_monthly_id"
STRIPE_PRO_ANNUAL_PRICE_ID="price_pro_annual_id"

# ------------------------------------------------------------------------------
# 5. Application & Storage Settings
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional Redis Cache / Rate Limiting (default fallback is in-memory sliding window):
# REDIS_URL="redis://localhost:6379"

# Standalone build toggle (set true when building inside Docker):
# BUILD_STANDALONE="true"
